# Environment variables are used ONLY for secrets / API tokens.
# The core pipeline favors free, credential-free public sources and needs none of these.

# Optional: NOAA NCEI token for the Climate Data Online (CDO) API (not required;
# GHCN-Daily bulk files and the NWS API are used by default and need no token).
# Request one at https://www.ncdc.noaa.gov/cdo-web/token
CDO_TOKEN=

# Optional: contact email advertised in the User-Agent for api.weather.gov (NWS asks for one).
NWS_API_USER_AGENT_EMAIL=

# Optional: AWS credentials are NOT required for NOAA Open Data on S3 (anonymous access).
# Leave unset unless you have a specific requester-pays or private bucket need.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
