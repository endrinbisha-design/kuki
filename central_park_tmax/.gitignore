__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Data & artifacts: keep the directory tree (via .gitkeep) but not bulk contents.
data/raw/**
data/interim/**
data/processed/**
data/predictions/**
data/settlement/**
models/**
reports/figures/**
reports/metrics/**
reports/forecasts/**
reports/settlement/**
*.grib
*.grib2
*.nc
*.idx

# Keep fixtures (they are checked in intentionally)
!tests/fixtures/**
!**/.gitkeep

# Phoenix second-city port: keep config in git, but bulk data/models/figures ephemeral
# (same policy as the NYC data/ tree above; results are captured in committed summary docs).
data_phoenix/**
models_phoenix/**
reports_phoenix/figures/**
reports_phoenix/metrics/**

# Las Vegas third-city port (same policy as Phoenix): bulk data/models ephemeral.
data_vegas/**
models_vegas/**
reports_vegas/figures/**
reports_vegas/metrics/**

# Bulk MOS text cache (re-fetchable in minutes from IEM; derived series ARE committed).
backtest_datasets/mos_raw/**

# In-progress per-day checkpoint of the HRRR shape backtest; the final CSV is
# committed explicitly by the analysis step when the fetch completes.
backtest_datasets/hrrr_shape_backtest.csv
